{
  "name": "@cyzanfar/dewatermark-unicode",
  "version": "0.7.0",
  "description": "Context-aware, local-only Unicode text watermark artifact inspection and sanitation.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./sanitizer.d.ts",
      "import": "./sanitizer.mjs"
    },
    "./policy": "./unicode-policy.mjs"
  },
