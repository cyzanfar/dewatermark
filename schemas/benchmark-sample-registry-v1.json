{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cyzanfar/text-watermark-remover/main/schemas/benchmark-sample-registry-v1.json",
  "title": "Dewatermark benchmark sample registry v1",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_registry_sha256",
    "frozen_before_final_test",
    "freeze_record_sha256",
    "key_partitions",
    "samples"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "registry_classification": {
      "const": "synthetic_harness_fixture_not_performance_evidence"
    },
    "protocol_registry_sha256": { "$ref": "#/$defs/sha256" },
    "frozen_before_final_test": { "type": "boolean" },
    "freeze_record_sha256": { "$ref": "#/$defs/sha256" },
    "key_partitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_fingerprint", "split"],
        "properties": {
          "key_fingerprint": { "$ref": "#/$defs/sha256" },
          "split": { "$ref": "#/$defs/split" }
        }
      }
    },
    "samples": {
      "type": "array",
      "items": { "$ref": "#/$defs/sample" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "publicId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"
    },
    "riskCodeOrCommitment": {
      "oneOf": [
        {
          "enum": [
            "high",
            "low",
            "medium",
            "not_assessed",
            "not_assessed_synthetic_fixture",
            "unknown"
          ]
        },
        { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      ]
    },
    "split": { "enum": ["calibration", "development", "final_test"] },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_id",
        "cluster_id",
        "split",
        "task",
        "language",
        "cohort",
        "input_sha256",
        "effective_detector_tokens",
        "length_bin",
        "key_fingerprint",
        "task_checkers",
        "metadata"
      ],
      "properties": {
        "sample_id": { "$ref": "#/$defs/publicId" },
        "cluster_id": { "$ref": "#/$defs/publicId" },
        "split": { "$ref": "#/$defs/split" },
        "task": {
          "enum": [
            "open_ended_prose",
            "factual_qa",
            "summarization",
            "translation",
            "code",
            "mathematics",
            "structured_data"
          ]
        },
        "language": { "enum": ["en", "es", "ar", "hi", "zh-Hans", "ko"] },
        "cohort": {
          "enum": ["watermarked_positive", "matched_generator_null", "human_control"]
        },
        "input_sha256": { "$ref": "#/$defs/sha256" },
        "effective_detector_tokens": { "type": "integer", "minimum": 0 },
        "length_bin": { "enum": ["lt64", "64_127", "128_255", "256_511", "512_plus"] },
        "key_fingerprint": {
          "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        },
        "task_checkers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/publicId" }
        },
        "metadata": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "cohort": { "const": "watermarked_positive" } } },
          "then": {
            "properties": {
              "metadata": {
                "type": "object",
                "additionalProperties": false,
                "required": ["generator_id", "decoding_config_sha256"],
                "properties": {
                  "generator_id": { "$ref": "#/$defs/publicId" },
                  "decoding_config_sha256": { "$ref": "#/$defs/sha256" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "cohort": { "const": "matched_generator_null" } } },
          "then": {
            "properties": {
              "metadata": {
                "type": "object",
                "additionalProperties": false,
                "required": ["generator_id", "decoding_config_sha256", "paired_sample_id"],
                "properties": {
                  "generator_id": { "$ref": "#/$defs/publicId" },
                  "decoding_config_sha256": { "$ref": "#/$defs/sha256" },
                  "paired_sample_id": { "$ref": "#/$defs/publicId" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "cohort": { "const": "human_control" } } },
          "then": {
            "properties": {
              "key_fingerprint": { "type": "null" },
              "metadata": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "content_sha256",
                  "license_id",
                  "source_date",
                  "domain",
                  "selection_rule_sha256",
                  "matching_rule_sha256",
                  "contamination_risk",
                  "memorization_risk",
                  "generator_exposed",
                  "rewriter_exposed"
                ],
                "properties": {
                  "content_sha256": { "$ref": "#/$defs/sha256" },
                  "license_id": { "$ref": "#/$defs/publicId" },
                  "source_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                  "domain": { "$ref": "#/$defs/publicId" },
                  "selection_rule_sha256": { "$ref": "#/$defs/sha256" },
                  "matching_rule_sha256": { "$ref": "#/$defs/sha256" },
                  "contamination_risk": { "$ref": "#/$defs/riskCodeOrCommitment" },
                  "memorization_risk": { "$ref": "#/$defs/riskCodeOrCommitment" },
                  "generator_exposed": { "const": false },
                  "rewriter_exposed": { "const": false }
                }
              }
            }
          }
        }
      ]
    }
  }
}
