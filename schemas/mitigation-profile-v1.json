{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cyzanfar/text-watermark-remover/main/schemas/mitigation-profile-v1.json",
  "title": "Dewatermark operator-scoped mitigation profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "classification",
    "scheme",
    "watermark_target_sha256",
    "key_id",
    "primary",
    "verifiers",
    "strategies",
    "quality_policy",
    "random_seed",
    "search_limits",
    "evidence",
    "profile_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "profile_id": {"$ref": "#/$defs/publicId"},
    "classification": {"const": "operator_scoped_detector_profile"},
    "scheme": {"$ref": "#/$defs/publicId"},
    "watermark_target_sha256": {"$ref": "#/$defs/sha256"},
    "key_id": {
      "$ref": "#/$defs/publicId",
      "description": "Opaque non-secret operator key identifier; it MUST NOT be derived from key material."
    },
    "primary": {"$ref": "#/$defs/component"},
    "verifiers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/component"}
    },
    "strategies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/strategy"}
    },
    "quality_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_sha256"],
      "properties": {
        "policy_id": {"const": "deterministic-required-gates-v1"},
        "policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "random_seed": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "search_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_rounds",
        "beam_width",
        "max_candidates",
        "max_transform_calls",
        "max_detector_queries",
        "max_candidate_characters",
        "max_verification_candidates"
      ],
      "properties": {
        "max_rounds": {"type": "integer", "minimum": 1, "maximum": 32},
        "beam_width": {"type": "integer", "minimum": 1, "maximum": 32},
        "max_candidates": {"type": "integer", "minimum": 1, "maximum": 1000},
        "max_transform_calls": {"type": "integer", "minimum": 1, "maximum": 1000},
        "max_detector_queries": {"type": "integer", "minimum": 1, "maximum": 100000},
        "max_candidate_characters": {"type": "integer", "minimum": 1, "maximum": 10000000},
        "max_verification_candidates": {"type": "integer", "minimum": 1, "maximum": 128}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "protocol_sha256"],
      "properties": {
        "status": {"const": "protocol_only_no_results"},
        "protocol_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "Exact preregistered protocol identity only; this profile schema cannot attach or promote result evidence."
        }
      }
    },
    "profile_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "publicId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"
    },
    "component": {
      "oneOf": [
        {"$ref": "#/$defs/pythonComponent"},
        {"$ref": "#/$defs/commandComponent"}
      ]
    },
    "pythonComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "capability_sha256",
        "implementation_sha256",
        "static_state_sha256"
      ],
      "properties": {
        "name": {"$ref": "#/$defs/publicId"},
        "capability_sha256": {"$ref": "#/$defs/sha256"},
        "implementation_sha256": {"$ref": "#/$defs/sha256"},
        "static_state_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "commandComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "capability_sha256",
        "implementation_sha256",
        "static_state_sha256",
        "command_code_sha256",
        "command_code_raw_sha256",
        "external_implementation_sha256"
      ],
      "properties": {
        "name": {"$ref": "#/$defs/publicId"},
        "capability_sha256": {"$ref": "#/$defs/sha256"},
        "implementation_sha256": {"$ref": "#/$defs/sha256"},
        "static_state_sha256": {"$ref": "#/$defs/sha256"},
        "command_code_sha256": {"$ref": "#/$defs/sha256"},
        "command_code_raw_sha256": {"$ref": "#/$defs/sha256"},
        "external_implementation_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "capability_sha256",
        "implementation_sha256",
        "static_state_sha256",
        "options"
      ],
      "properties": {
        "name": {"$ref": "#/$defs/publicId"},
        "capability_sha256": {"$ref": "#/$defs/sha256"},
        "implementation_sha256": {"$ref": "#/$defs/sha256"},
        "static_state_sha256": {"$ref": "#/$defs/sha256"},
        "options": {"type": "object"}
      }
    }
  }
}
