{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cyzanfar/text-watermark-remover/main/schemas/benchmark-observation-set-v1.json",
  "title": "Dewatermark benchmark observation set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_set_id",
    "sample_registry_sha256",
    "run_manifest",
    "detectors",
    "conditions",
    "requested_fprs",
    "observations",
    "resource_summary",
    "human_review",
    "reproduction"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "observation_set_id": { "$ref": "#/$defs/sha256" },
    "sample_registry_sha256": { "$ref": "#/$defs/sha256" },
    "run_manifest": { "type": "object" },
    "detectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "manifest"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "role": { "enum": ["primary", "cross"] },
          "manifest": { "type": "object" }
        }
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "transform_manifest_sha256", "quality_gate_manifest_sha256"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "transform_manifest_sha256": { "$ref": "#/$defs/sha256" },
          "quality_gate_manifest_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "requested_fprs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 }
    },
    "observations": {
      "type": "array",
      "items": { "$ref": "#/$defs/observation" }
    },
    "resource_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_size_bytes"],
      "properties": {
        "model_size_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "execution_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["limits", "usage", "deadline_at_unix"],
          "properties": {
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "max_records",
                "max_requested_tokens",
                "max_adapter_processes",
                "deadline_seconds",
                "max_cancellation_checks"
              ],
              "properties": {
                "max_records": { "type": "integer", "minimum": 1 },
                "max_requested_tokens": { "type": "integer", "minimum": 1 },
                "max_adapter_processes": { "type": "integer", "minimum": 1 },
                "deadline_seconds": { "type": "integer", "minimum": 1 },
                "max_cancellation_checks": { "type": "integer", "minimum": 1 }
              }
            },
            "usage": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "records",
                "requested_tokens",
                "adapter_processes",
                "cancellation_checks"
              ],
              "properties": {
                "records": { "type": "integer", "minimum": 0 },
                "requested_tokens": { "type": "integer", "minimum": 0 },
                "adapter_processes": { "type": "integer", "minimum": 0 },
                "cancellation_checks": { "type": "integer", "minimum": 0 }
              }
            },
            "deadline_at_unix": { "type": "number", "minimum": 0 }
          }
        },
        "adapter_processes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["started", "completed", "failed", "telemetry_incomplete"],
          "properties": {
            "started": { "type": "integer", "minimum": 0 },
            "completed": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "telemetry_incomplete": { "type": "integer", "minimum": 0 }
          }
        },
        "adapter_process_resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "telemetry_complete",
            "wall_time_seconds",
            "peak_rss_bytes",
            "remote_queries",
            "generated_tokens",
            "estimated_cost_usd"
          ],
          "properties": {
            "telemetry_complete": { "type": "boolean" },
            "wall_time_seconds": { "type": "number", "minimum": 0 },
            "peak_rss_bytes": { "type": ["integer", "null"], "minimum": 0 },
            "remote_queries": { "type": ["integer", "null"], "minimum": 0 },
            "generated_tokens": { "type": ["integer", "null"], "minimum": 0 },
            "estimated_cost_usd": { "type": ["number", "null"], "minimum": 0 }
          }
        },
        "run_attempts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sample_failures", "observation_failures", "observation_attempts"],
          "properties": {
            "sample_failures": { "type": "integer", "minimum": 0 },
            "observation_failures": { "type": "integer", "minimum": 0 },
            "observation_attempts": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "human_review": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reason"],
          "properties": {
            "state": { "enum": ["not_run", "not_available"] },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "packet_sha256",
            "assignment_sha256",
            "protocol_sha256",
            "reviewer_count",
            "blinded",
            "pre_registered",
            "agreement"
          ],
          "properties": {
            "state": { "const": "complete" },
            "packet_sha256": { "$ref": "#/$defs/sha256" },
            "assignment_sha256": { "$ref": "#/$defs/sha256" },
            "protocol_sha256": { "$ref": "#/$defs/sha256" },
            "reviewer_count": { "type": "integer", "minimum": 2 },
            "blinded": { "const": true },
            "pre_registered": { "const": true },
            "agreement": {
              "type": "object",
              "additionalProperties": false,
              "required": ["metric", "value", "ci95"],
              "properties": {
                "metric": { "enum": ["krippendorff_alpha", "fleiss_kappa"] },
                "value": { "type": "number", "minimum": -1, "maximum": 1 },
                "ci95": {
                  "type": "array",
                  "prefixItems": [
                    { "type": "number", "minimum": -1, "maximum": 1 },
                    { "type": "number", "minimum": -1, "maximum": 1 }
                  ],
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            }
          }
        }
      ]
    },
    "reproduction": { "$ref": "#/$defs/reproduction" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipe_sha256",
        "timeout_seconds",
        "network_required",
        "model_download_required"
      ],
      "properties": {
        "recipe_sha256": { "$ref": "#/$defs/sha256" },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 604800 },
        "network_required": { "type": "boolean" },
        "model_download_required": { "type": "boolean" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_id",
        "detector_id",
        "condition_id",
        "source_score",
        "candidate_score",
        "source_effective_tokens",
        "candidate_effective_tokens",
        "transformation_state",
        "quality_gate_passed",
        "task_check_passed",
        "error_class",
        "telemetry"
      ],
      "properties": {
        "sample_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "detector_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "condition_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "source_score": { "type": "number" },
        "candidate_score": { "type": "number" },
        "source_effective_tokens": { "type": "integer", "minimum": 0 },
        "candidate_effective_tokens": { "type": "integer", "minimum": 0 },
        "transformation_state": { "enum": ["accepted", "failed", "abstained"] },
        "quality_gate_passed": { "type": ["boolean", "null"] },
        "task_check_passed": { "type": ["boolean", "null"] },
        "error_class": { "type": ["string", "null"], "maxLength": 256 },
        "telemetry": { "$ref": "#/$defs/attemptTelemetry" },
        "attempt_history": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "attempt_index",
              "state",
              "error_class",
              "telemetry",
              "telemetry_complete"
            ],
            "properties": {
              "attempt_index": { "type": "integer", "minimum": 1 },
              "state": { "enum": ["accepted", "failed", "abstained"] },
              "error_class": { "type": ["string", "null"], "maxLength": 256 },
              "telemetry": { "$ref": "#/$defs/attemptTelemetry" },
              "telemetry_complete": { "type": "boolean" }
            }
          }
        }
      }
    },
    "attemptTelemetry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "wall_time_seconds",
            "peak_rss_bytes",
            "remote_queries",
            "generated_tokens",
            "estimated_cost_usd"
          ],
          "properties": {
            "wall_time_seconds": { "type": "number", "minimum": 0 },
            "peak_rss_bytes": { "type": ["integer", "null"], "minimum": 0 },
            "remote_queries": { "type": ["integer", "null"], "minimum": 0 },
            "generated_tokens": { "type": ["integer", "null"], "minimum": 0 },
            "estimated_cost_usd": { "type": ["number", "null"], "minimum": 0 }
          }
    }
  }
}
