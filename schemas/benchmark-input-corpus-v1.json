{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cyzanfar/text-watermark-remover/main/schemas/benchmark-input-corpus-v1.json",
  "title": "Dewatermark private benchmark input corpus v1",
  "description": "Private operator input. Raw prompts and human controls are never copied to public artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "cluster_id",
          "split",
          "task",
          "language",
          "requested_tokens",
          "prompt",
          "human_control"
        ],
        "properties": {
          "record_id": { "$ref": "#/$defs/publicId" },
          "cluster_id": { "$ref": "#/$defs/publicId" },
          "split": { "enum": ["calibration", "development", "final_test"] },
          "task": {
            "enum": [
              "open_ended_prose",
              "factual_qa",
              "summarization",
              "translation",
              "code",
              "mathematics",
              "structured_data"
            ]
          },
          "language": { "enum": ["en", "es", "ar", "hi", "zh-Hans", "ko"] },
          "requested_tokens": { "type": "integer", "minimum": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "human_control": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text",
                  "license_id",
                  "source_date",
                  "domain",
                  "selection_rule_sha256",
                  "matching_rule_sha256",
                  "contamination_risk",
                  "memorization_risk"
                ],
                "properties": {
                  "text": { "type": "string", "minLength": 1 },
                  "license_id": { "$ref": "#/$defs/publicId" },
                  "source_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                  "domain": { "$ref": "#/$defs/publicId" },
                  "selection_rule_sha256": { "$ref": "#/$defs/sha256" },
                  "matching_rule_sha256": { "$ref": "#/$defs/sha256" },
                  "contamination_risk": { "$ref": "#/$defs/risk" },
                  "memorization_risk": { "$ref": "#/$defs/risk" }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "publicId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$"
    },
    "risk": {
      "oneOf": [
        { "enum": ["high", "low", "medium", "not_assessed", "not_assessed_synthetic_fixture", "unknown"] },
        { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      ]
    }
  }
}
