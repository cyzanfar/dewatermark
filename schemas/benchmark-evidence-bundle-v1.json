{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cyzanfar/text-watermark-remover/main/schemas/benchmark-evidence-bundle-v1.json",
  "title": "Dewatermark benchmark evidence bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_type",
    "bundle_id",
    "purpose",
    "manifest",
    "protocol_registry",
    "sample_registry",
    "protocol_coverage",
    "results",
    "artifacts",
    "resource_telemetry",
    "reproduction",
    "claim_eligibility"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "bundle_type": { "const": "dewatermark_benchmark_evidence" },
    "bundle_id": { "$ref": "#/$defs/sha256" },
    "purpose": {
      "enum": ["harness_conformance", "exploratory", "frozen_evaluation"]
    },
    "manifest": { "$ref": "#/$defs/publicManifest" },
    "protocol_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sample_registry": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["sha256", "sample_count"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "sample_count": { "type": "integer", "minimum": 0 }
      }
    },
    "protocol_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reproducible_identity",
        "independent_splits",
        "matched_controls",
        "held_out_keys",
        "length_coverage",
        "task_coverage",
        "language_coverage",
        "detector_statistics",
        "negative_effects",
        "quality_preservation",
        "human_evaluation",
        "resource_accounting",
        "artifact_handling",
        "independent_replication"
      ],
      "properties": {
        "reproducible_identity": { "$ref": "#/$defs/coverage" },
        "independent_splits": { "$ref": "#/$defs/coverage" },
        "matched_controls": { "$ref": "#/$defs/coverage" },
        "held_out_keys": { "$ref": "#/$defs/coverage" },
        "length_coverage": { "$ref": "#/$defs/coverage" },
        "task_coverage": { "$ref": "#/$defs/coverage" },
        "language_coverage": { "$ref": "#/$defs/coverage" },
        "detector_statistics": { "$ref": "#/$defs/coverage" },
        "negative_effects": { "$ref": "#/$defs/coverage" },
        "quality_preservation": { "$ref": "#/$defs/coverage" },
        "human_evaluation": { "$ref": "#/$defs/coverage" },
        "resource_accounting": { "$ref": "#/$defs/coverage" },
        "artifact_handling": { "$ref": "#/$defs/coverage" },
        "independent_replication": { "$ref": "#/$defs/coverage" }
      }
    },
    "results": { "$ref": "#/$defs/publicResults" },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "resource_telemetry": { "$ref": "#/$defs/telemetry" },
    "reproduction": { "$ref": "#/$defs/reproduction" },
    "claim_eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_complete",
        "comparative_performance_eligible",
        "best_in_class_eligible",
        "reason_codes"
      ],
      "properties": {
        "protocol_complete": { "type": "boolean" },
        "comparative_performance_eligible": { "const": false },
        "best_in_class_eligible": { "const": false },
        "reason_codes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "publicToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]{0,255}$"
    },
    "publicManifest": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": false,
      "properties": {
        "schema_version": { "$ref": "#/$defs/publicToken" },
        "classification": { "$ref": "#/$defs/publicToken" },
        "fixture": { "$ref": "#/$defs/publicToken" },
        "version": { "$ref": "#/$defs/publicToken" },
        "watermark_family": { "enum": ["kgw", "synthid_text"] },
        "network_allowed": { "type": "boolean" },
        "model_download_allowed": { "type": "boolean" }
      },
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9_]*_sha256$": { "$ref": "#/$defs/sha256" },
        "^[A-Za-z0-9][A-Za-z0-9_]*_(id|version|revision)$": { "$ref": "#/$defs/publicToken" },
        "^[A-Za-z0-9][A-Za-z0-9_]*_(allowed|required)$": { "type": "boolean" },
        "^[A-Za-z0-9][A-Za-z0-9_]*_count$": { "type": "integer", "minimum": 0 }
      }
    },
    "scoreTableReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "records"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "records": { "type": "integer", "minimum": 0 }
      }
    },
    "publicResults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "1.0" },
        "classification": { "$ref": "#/$defs/publicToken" },
        "positive_scores": {
          "type": "array",
          "items": { "type": "number" }
        },
        "calibration_null_scores": {
          "type": "array",
          "items": { "type": "number" }
        },
        "test_null_scores": {
          "type": "array",
          "items": { "type": "number" }
        },
        "failures": { "type": "integer", "minimum": 0 },
        "abstentions": { "type": "integer", "minimum": 0 },
        "attempted": { "type": "integer", "minimum": 0 },
        "aggregate_sha256": { "$ref": "#/$defs/sha256" },
        "observation_set_id": { "$ref": "#/$defs/sha256" },
        "sample_registry_sha256": { "$ref": "#/$defs/sha256" },
        "groups": { "type": "object" },
        "cross_detector_confusion": { "type": "object" },
        "comparative_analysis": { "$ref": "#/$defs/comparativeAnalysis" },
        "score_tables": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/scoreTableReference" }
        },
        "failure_classes": { "type": "object" },
        "coverage": { "type": "object" },
        "resource_telemetry": { "$ref": "#/$defs/telemetry" }
      }
    },
    "comparativeAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "alpha",
        "control_condition_id",
        "tested_hypotheses",
        "estimable_hypotheses",
        "unavailable_hypotheses",
        "tests"
      ],
      "properties": {
        "method": {
          "enum": [
            "holm_bonferroni_cluster_paired_sign_test"
          ]
        },
        "alpha": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "control_condition_id": { "$ref": "#/$defs/publicToken" },
        "tested_hypotheses": { "type": "integer", "minimum": 0 },
        "estimable_hypotheses": { "type": "integer", "minimum": 0 },
        "unavailable_hypotheses": { "type": "integer", "minimum": 0 },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "detector_id",
              "requested_fpr",
              "condition_id",
              "control_condition_id",
              "estimable",
              "reason_code",
              "paired_clusters",
              "paired_samples",
              "condition_attempts",
              "control_attempts",
              "condition_cluster_wins",
              "control_cluster_wins",
              "cluster_ties",
              "success_rate_difference",
              "raw_p_value",
              "adjusted_p_value",
              "reject_null",
              "family_hypotheses"
            ],
            "properties": {
              "detector_id": { "$ref": "#/$defs/publicToken" },
              "requested_fpr": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
              "condition_id": { "$ref": "#/$defs/publicToken" },
              "control_condition_id": { "$ref": "#/$defs/publicToken" },
              "estimable": { "type": "boolean" },
              "reason_code": { "type": ["string", "null"], "minLength": 1 },
              "paired_clusters": { "type": "integer", "minimum": 0 },
              "paired_samples": { "type": "integer", "minimum": 0 },
              "condition_attempts": { "type": "integer", "minimum": 0 },
              "control_attempts": { "type": "integer", "minimum": 0 },
              "condition_cluster_wins": { "type": "integer", "minimum": 0 },
              "control_cluster_wins": { "type": "integer", "minimum": 0 },
              "cluster_ties": { "type": "integer", "minimum": 0 },
              "success_rate_difference": { "type": ["number", "null"], "minimum": -1, "maximum": 1 },
              "raw_p_value": { "type": "number", "minimum": 0, "maximum": 1 },
              "adjusted_p_value": { "type": "number", "minimum": 0, "maximum": 1 },
              "reject_null": { "type": "boolean" },
              "family_hypotheses": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "coverage": {
      "type": "object",
      "required": ["state", "reason"],
      "properties": {
        "state": {
          "enum": ["complete", "partial", "not_run", "not_available", "not_applicable"]
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "canonical_sha256",
        "bytes",
        "media_type",
        "privacy_class"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "canonical_sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 256 },
        "privacy_class": { "const": "public_aggregate_no_text" }
      }
    },
    "telemetryValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "value", "unit"],
      "properties": {
        "state": { "enum": ["measured", "declared", "not_available", "not_applicable"] },
        "value": { "type": ["number", "integer", "null"], "minimum": 0 },
        "unit": { "type": "string", "minLength": 1 }
      }
    },
    "telemetry": {
      "type": "object",
      "required": [
        "wall_time",
        "process_cpu_time",
        "peak_rss",
        "model_size",
        "remote_queries",
        "generated_tokens",
        "estimated_cost"
      ],
      "propertyNames": {
        "pattern": "^(wall_time|process_cpu_time|peak_rss|model_size|remote_queries|generated_tokens|estimated_cost|operation\\.[A-Za-z0-9][A-Za-z0-9._-]{0,127})$"
      },
      "additionalProperties": { "$ref": "#/$defs/telemetryValue" }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipe_sha256",
        "timeout_seconds",
        "network_required",
        "model_download_required"
      ],
      "properties": {
        "recipe_sha256": { "$ref": "#/$defs/sha256" },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 604800 },
        "network_required": { "type": "boolean" },
        "model_download_required": { "type": "boolean" }
      }
    }
  }
}
